{
  "name": "naquela-mesa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "owner:ensure": "node --env-file-if-exists=.env.local --import tsx scripts/ensure-store-owner.ts",
    "admin:ensure": "node --env-file-if-exists=.env.local --import tsx scripts/ensure-super-admin.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "e2e:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/e2e-cleanup.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.7.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
